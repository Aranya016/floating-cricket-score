{
  "manifest_version": 3,
  "name": "Floating Cricket Score",
  "version": "1.1.0",
  "description": "A small live cricket score that floats on every tab, like the score bubble on your phone. Scores from ESPNcricinfo.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["widget.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Floating Cricket Score",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-widget": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Show or hide the floating score"
    }
  }
}
